# Reconly — server environment variables
# Copy to .env.local for local dev. NEVER commit real values.

# Anthropic API key for the copilot route (/api/copilot).
# Set in Vercel project settings for deploys.
# REQUIRED OPERATIONAL STEP: set a hard monthly spend limit on this key
# in the Anthropic console — it is the final backstop against abuse.
ANTHROPIC_API_KEY=

# Upstash Redis (REST) for distributed rate limiting.
# REQUIRED in production: without these the copilot route fails closed and
# denies all requests (per-instance memory counting is no limit at all on
# serverless). Local dev falls back to in-memory limiting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: explicit allowed origin for the copilot route when the app is
# served behind a proxy whose Host header differs from the public origin.
# Same-origin requests are always allowed without this.
# COPILOT_ALLOWED_ORIGIN=https://reconly.example.com

# DEV ONLY: run the copilot against a local Ollama model instead of the
# Anthropic API (for guardrail-harness testing without a key). Ignored
# whenever ANTHROPIC_API_KEY is set, and never active in production builds.
# COPILOT_DEV_OLLAMA_MODEL=qwen3:30b-a3b-q4_K_M
# OLLAMA_BASE_URL=http://localhost:11434
